{
  "schema_version": "capd_finals_v3_0",
  "contract": {
    "id": "CAPD-MIC-1.0"
  },
  "run_profile": "official",
  "memory": {
    "dram_capacity_pages": 64,
    "nvm_capacity_pages": null
  },
  "replay": {
    "dram_initial_state": "empty",
    "initial_residency": "all_trace_pages_in_nvm",
    "trace_page_backing": "all_trace_pages",
    "first_touch_accounting": "nvm_access",
    "dirty_demotion_nvm_write": "none"
  },
  "trace": {
    "page_shift": 12
  },
  "candidate": {
    "pool_size_B": 64,
    "retained_K": 8,
    "selector_history_Hc": 256
  },
  "history": {
    "transformer_H": 10
  },
  "labels": {
    "future_lookahead_L": 256,
    "tail_policy": "drop_incomplete_window",
    "lambda_d": 1.0,
    "lambda_q": 1.0,
    "lambda_w": 4.0
  },
  "features": {
    "residency_scale_Lres": 256,
    "page_state_dim": 4,
    "selector_clip_quantile": 0.99,
    "lru_direction": "oldest_is_one"
  },
  "selector": {
    "grid_step": 0.1,
    "epsilon_y": 1e-08,
    "behavior_policy": "lru"
  },
  "metrics": {
    "selector_recall_tie": "any_hit"
  },
  "validation": {
    "strategy": "independent_valid_trace",
    "development_fallback": "train_trace_decision_holdout",
    "artifact_class": "official",
    "holdout_fraction": 0.2,
    "rounding": "ceil",
    "guard_accesses": 256
  },
  "embedding": {
    "page": {
      "shared": true,
      "vocab_fit": "train_only",
      "oov": "unk",
      "unk_index": 0,
      "max_vocab_size": 100000
    },
    "pc": {
      "vocab_fit": "train_only",
      "oov": "unk",
      "unk_index": 0,
      "max_vocab_size": 50000
    }
  },
  "model": {
    "position_encoding": "sinusoidal"
  },
  "loss": {
    "approx_ndcg_alpha": 10.0
  },
  "training": {
    "scope": "per_workload",
    "seed": 3136859,
    "epochs": 10,
    "batch_size": 32,
    "learning_rate": 0.0001
  },
  "evaluation": {
    "random_seed": 0
  },
  "cost_model": {
    "dram_read_cost": 1.0,
    "dram_write_cost": 1.0,
    "nvm_read_cost": 2.0,
    "nvm_write_cost": 8.0,
    "migration_cost": 10.0
  },
  "sweep": {
    "pool_sizes_B": [8, 16, 32, 64]
  },
  "workloads": {
    "canneal": {
      "train_trace": "dataset/processed/real_workload_suite/1m/parsec_canneal_train.csv",
      "valid_trace": "dataset/processed/real_workload_suite/1m/parsec_canneal_valid.csv",
      "test_trace": "dataset/processed/real_workload_suite/1m/parsec_canneal_test.csv"
    },
    "streamcluster_pressure": {
      "train_trace": "dataset/processed/real_workload_suite_pressure/selected/parsec_streamcluster_train.csv",
      "valid_trace": "dataset/processed/real_workload_suite_pressure/selected/parsec_streamcluster_valid.csv",
      "test_trace": "dataset/processed/real_workload_suite_pressure/selected/parsec_streamcluster_test.csv"
    },
    "dedup_pressure": {
      "train_trace": "dataset/processed/real_workload_suite_pressure/selected/parsec_dedup_train.csv",
      "valid_trace": "dataset/processed/real_workload_suite_pressure/selected/parsec_dedup_valid.csv",
      "test_trace": "dataset/processed/real_workload_suite_pressure/selected/parsec_dedup_test.csv"
    }
  },
  "outputs": {
    "jsonl_root": "dataset/jsonl/finals_v3_official",
    "checkpoint_root": "outputs/checkpoints/finals_v3_official",
    "result_root": "outputs/results/finals_v3_official"
  }
}
